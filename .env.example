# GEMINI_API_KEY: Required for Gemini AI shopping assistant API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Project URL: https://hxibukwtqfqwzdijmftq.supabase.co
SUPABASE_URL="https://hxibukwtqfqwzdijmftq.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Server-side privileged operations (Vercel Serverless / Node backend - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Session JWT secret
SESSION_SECRET="your-strong-production-jwt-secret-key-32-chars-min"

# Client-side Vite environment variables (Vercel Production & Preview)
VITE_SUPABASE_URL="https://hxibukwtqfqwzdijmftq.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
